# Copy to .env and change every value. Never commit .env.
POSTGRES_PASSWORD=change-me-long-random
MINIFLUX_ADMIN=admin
MINIFLUX_PASSWORD=change-me-too
# the address you open Miniflux at (used for links inside Miniflux)
MINIFLUX_BASE_URL=http://localhost:8080
# optional: Instagram cookies for RSS-Bridge (from a logged-in browser: sessionid and ds_user_id)
IG_SESSION_ID=
IG_DS_USER_ID=
# HTTPS (docker-compose.https.yml): your domain, or <ip-with-dashes>.sslip.io, e.g. 140-238-1-2.sslip.io
DOMAIN=
# 127.0.0.1 keeps Miniflux's plain-http port private when HTTPS is in front of it
BIND=0.0.0.0
